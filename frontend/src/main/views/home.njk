  {# Render tasks if present #}
  {% if tasks and tasks.length %}
    <h2 class="govuk-heading-l">Tasks</h2>
    {% for task in tasks %}
      {{ govukSummaryList({
        rows: [
          {
            key: { text: "ID" },
            value: { text: task.id },
            actions: {
              items: [
                {
                  href: "/tasks/" + task.id + "/change",
                  text: "Change",
                  visuallyHiddenText: "change task id"
                }
              ]
            }
          },
          {
            key: { text: "Title" },
            value: { text: task.title },
            actions: {
              items: [
                {
                  href: "/tasks/" + task.id + "/change-title",
                  text: "Change",
                  visuallyHiddenText: "change task title"
                }
              ]
            }
          },
          {
            key: { text: "Description" },
            value: { text: task.description },
            actions: {
              items: [
                {
                  href: "/tasks/" + task.id + "/delete",
                  text: "Delete",
                  visuallyHiddenText: "delete task description"
                },
                {
                  href: "/tasks/" + task.id + "/change-description",
                  text: "Change",
                  visuallyHiddenText: "change task description"
                }
              ]
            }
          },
          {
            key: { text: "Status" },
            value: { text: task.status }
          },
          {
            key: { text: "Due Date" },
            value: { text: task.dueDate }
          },
          {
            key: { text: "Created Date" },
            value: { text: task.createdDate }
          }
        ]
      }) }}
    {% endfor %}
  {% else %}
    <p>No tasks found.</p>
  {% endif %}

{% endblock %}
